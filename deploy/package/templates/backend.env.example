# =====================================================================
# RMUDTS backend environment — EXAMPLE ONLY
# =====================================================================
# The installation wizard writes the real .env into rmudts-config/ (0600)
# and places an identical copy beside server.js. Use this file only when
# repairing an installation by hand.
#
# Never commit a real .env and never put one inside public_html.

NODE_ENV=production
APP_ENV=production
APP_NAME=RMUDTS
APP_URL=https://domain.com/rmudts/
APP_KEY=replace-with-64-url-safe-characters

CLIENT_URL=https://domain.com/rmudts/
CLIENT_ORIGIN=https://domain.com
API_URL=https://api.domain.com/
SOCKET_URL=https://api.domain.com/
SOCKET_PATH=/socket.io

TZ=Asia/Manila
LOG_LEVEL=info
SYSTEM_EMAIL=records@domain.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_rmudts
DB_USER=cpaneluser_rmudts_user
DB_PASS=replace-with-the-database-password

JWT_SECRET=replace-with-64-url-safe-characters
REFRESH_TOKEN_SECRET=replace-with-64-url-safe-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
CSRF_SECRET=replace-with-64-hex-characters
API_TOKEN=replace-with-64-hex-characters

UPLOAD_DIR=/home/cpaneluser/rmudts-uploads
DATA_DIR=/home/cpaneluser/rmudts-data
LOG_DIR=/home/cpaneluser/rmudts-logs
BACKUP_DIR=/home/cpaneluser/rmudts-backups
TMP_DIR=/home/cpaneluser/rmudts-data/tmp
CACHE_DIR=/home/cpaneluser/rmudts-data/cache

# PORT is intentionally NOT set here. cPanel Passenger assigns
# process.env.PORT to the application; hard-coding it makes the app
# unreachable behind the Passenger entry point.
RMUDTS_CONFIG_DIR=/home/cpaneluser/rmudts-config
