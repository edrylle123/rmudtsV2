# =====================================================================
# RMUDTS frontend build variables — EXAMPLE ONLY
# =====================================================================
# These are compile-time values for the React build. They are PUBLIC by
# definition: never put a password, JWT secret or API token here.
#
# Build the client with:
#   cd client
#   PUBLIC_URL=/rmudts/ REACT_APP_API_BASE=https://api.domain.com npm run build
#
# The runtime values can also be changed after installation without a
# rebuild: the installer writes rmudts/runtime-config.js, which the SPA
# reads before creating the API and Socket.IO clients.

PUBLIC_URL=/rmudts/
REACT_APP_API_BASE=https://api.domain.com
REACT_APP_SOCKET_URL=https://api.domain.com
REACT_APP_SOCKET_PATH=/socket.io
REACT_APP_APP_NAME=RMUDTS
